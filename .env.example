# Database — Neon pooled connection string (or local Postgres)
# Neon example: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://ethio:ethio@localhost:5432/project_manager?schema=public

# NestJS API
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional email (password reset)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
