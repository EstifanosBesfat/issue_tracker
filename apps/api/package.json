{
  "name": "@ethio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node ./scripts/ensure-database.js && node ./scripts/run-nest.js build",
    "start": "node ./scripts/run-nest.js start",
    "start:dev": "node ./scripts/run-nest.js start --watch",
    "start:prod": "node dist/main.js",
    "dev:vercel": "npx vercel dev --listen 4000",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@ethio/database": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "express": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/passport-jwt": "^4.0.1",
    "@vercel/node": "^5.9.3",
    "typescript": "^5"
  }
}
